{
  "name": "e-vital-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "build:carte-inseed": "esbuild src/lib/carte.ts --bundle --minify --format=iife --global-name=EvitalCarte --target=es2017 --outfile=../backend/static/js/evital_carte.js",
    "build:telephone-django": "esbuild src/lib/telephoneDjango.ts --bundle --minify --format=iife --global-name=EvitalTelephone --target=es2017 --outfile=../backend/static/js/evital_telephone.js && esbuild src/styles/telephone.css --minify --outfile=../backend/static/css/evital-telephone.css",
    "build:selecteur-django": "esbuild src/lib/selecteurDjango.ts --bundle --minify --format=iife --global-name=EvitalSelecteur --target=es2017 --outfile=../backend/static/js/evital_selecteur.js && esbuild src/styles/selecteur.css --minify --outfile=../backend/static/css/evital-selecteur.css",
    "test:telephone": "node scripts/test-telephone.mjs",
    "test:formulaire": "node scripts/test-formulaire.mjs",
    "sync:telephone": "node scripts/sync-telephone.mjs"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "dexie": "^4.0.8",
    "echarts": "^6.1.0",
    "html5-qrcode": "^2.3.8",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.43.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.4",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
