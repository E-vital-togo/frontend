# Variables lues par le frontend au build (voir src/lib/config.ts).
# Aucun prefixe VITE_ : seuls ces deux noms exacts sont exposes au navigateur.
# Sur Vercel : Project > Settings > Environment Variables (memes noms), puis redeployer.

# URL de l'API du backend (sans barre finale ; "/api/v1" relatif accepte).
# Si absente, l'application utilise l'API de production (repli) : a definir.
API_BASE_URL=http://localhost:8000/api/v1

# URL publique de ce frontend (sans barre finale). Si absente : origine de la page.
FRONTEND_BASE_URL=http://localhost:5173
